rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Cada usuario es un documento: usuarios/{uid}
    match /usuarios/{uid} {
      // Cualquier usuario autenticado puede ver a los demas (para mostrarlos en el mapa)
      allow read: if request.auth != null;

      // Solo el dueno puede crear y modificar su propio documento
      allow create, update: if request.auth != null && request.auth.uid == uid;

      allow delete: if false;
    }
  }
}
